# Multi-User Mode Configuration
# ==============================

# Enable multi-user mode (required to activate all multi-user features)
MULTI_USER_MODE=true

# JWT secret for user session tokens (auto-generated if not set)
# MULTI_USER_JWT_SECRET=your-random-secret-here

# Default quota for new users (JSON format)
# MULTI_USER_DEFAULT_QUOTA={"dailyRequests":1000,"dailyTokens":10000000}

# Enable/disable new user registration (default: true)
# MULTI_USER_REGISTRATION=true

# Maximum API keys per user (default: 5)
# MULTI_USER_MAX_KEYS_PER_USER=5
